# Backend settings. The backend reads plain environment variables only: it does
# NOT load this file. Export them in your shell, for example
#     export ALLOWED_ORIGINS=https://voluntag.example
# or set them in your hosting provider's settings. Every variable is optional;
# when unset, the backend behaves exactly as it does locally today.

# Folder for everything the app writes and must keep between restarts:
# voluntag.db, uploads/ (with messages/ and resolutions/) and admin_secret.json.
# Created if missing. On a host, point it at a persistent disk.
# Keep it outside the git repository: only the default locations are git-ignored.
# Default (blank or unset): the backend folder itself.
DATA_DIR=

# Frontend addresses allowed to call the API (CORS), comma-separated.
# Scheme + host + port only, e.g. https://voluntag.example
# Spaces, empty items and a trailing slash are ignored.
# Default: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Insert the demo .test volunteers and NGOs when those tables are empty.
# false creates the tables only. Accepts true/false, 1/0, yes/no, on/off.
# Default: true
SEED_DEMO_DATA=true

# ── Environment and API docs ──────────────────────────────────────
# production switches the interactive API docs (/docs, /redoc,
# /openapi.json) off unless ENABLE_DOCS says otherwise. Default: development
APP_ENV=development
# Default: true in development, false in production
ENABLE_DOCS=
# Client address for rate limits. false (default): the address of whatever
# opened the connection; X-Forwarded-For is ignored, so clients cannot fake
# it. true: ONLY behind proxies you control that append X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# How many of your proxies sit in front of the app (load balancer = 1,
# load balancer + nginx = 2). The client address is the entry this many
# places from the RIGHT of X-Forwarded-For; entries further left are
# whatever the client sent and are never used. 0 with
# TRUST_PROXY_HEADERS=true is treated as 1 (with a warning). Default: 0
# Start uvicorn with --no-proxy-headers so only these two settings decide.
TRUSTED_PROXY_COUNT=0

# ── Upload limits (bytes / pixels) ───────────────────────────────
# Whole request body (Content-Length); larger requests get 413. Default 40 MB.
MAX_REQUEST_BYTES=41943040
# One photo (default 10 MB) and one document (default 5 MB); larger -> 413.
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=5242880
# Images larger than this many pixels are refused (decompression bombs).
MAX_IMAGE_PIXELS=25000000
# Photos are shrunk to fit this many pixels per side before BLIP and CLIP.
AI_IMAGE_MAX_SIDE=1024

# ── Rate limits ──────────────────────────────────────────────────
# Every limiter keeps its counters in one small SQLite file, so a restart
# does not clear them and all worker processes share them. Keys (emails,
# IPs) are stored only as salted hashes. Default: DATA_DIR/ratelimits.db
RATE_LIMIT_DB_PATH=
# per volunteer, POST /report-issue
REPORT_LIMIT_PER_HOUR=5
# per client IP, POST /add-volunteer
VOLUNTEER_SIGNUP_LIMIT_PER_HOUR=10
# per client IP, POST /add-ngo
NGO_SIGNUP_LIMIT_PER_HOUR=5
# POST /contact
CONTACT_LIMIT_PER_HOUR_PER_IP=3
# POST /contact
CONTACT_LIMIT_PER_DAY_PER_EMAIL=3
# Password reset limits are fixed in reset_limiter.py: 3/hour per account,
# 10/hour per IP (silently dropped), 10 new-password attempts / 10 min per IP.

# Volunteer / NGO login lockout. Wrong passwords count per (account, client
# IP): LOGIN_MAX_FAILURES within LOGIN_FAILURE_WINDOW_SECONDS lock that pair
# for LOGIN_LOCKOUT_SECONDS (a stranger on another network cannot lock the
# owner out). One IP may fail LOGIN_IP_MAX_FAILURES times across all
# accounts per LOGIN_IP_WINDOW_SECONDS. Last resort: an account with
# LOGIN_ACCOUNT_MAX_FAILURES_PER_HOUR failures from anywhere is locked for
# everyone until they are an hour old (a password reset clears it).
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
LOGIN_IP_MAX_FAILURES=30
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_ACCOUNT_MAX_FAILURES_PER_HOUR=50

# ── Email verification at signup ─────────────────────────────────
# true (default): new volunteer and NGO accounts must open the link mailed
# to them before they can log in, and registration answers the same way
# whether or not the email is already registered (the owner gets a notice).
# false (demos without mail): accounts are created confirmed, and a taken
# email gets the old "already registered" error. KNOWN TRADE-OFF: that
# error tells anyone which emails have accounts.
EMAIL_VERIFICATION_REQUIRED=true
# How long a confirmation link works.
EMAIL_VERIFICATION_HOURS=24
# POST /verify-email attempts per client IP per 10 minutes (429 above).
VERIFY_LIMIT_PER_IP_PER_10_MIN=20
# POST /resend-verification: per account (silently dropped above) and per IP (429).
RESEND_LIMIT_PER_ACCOUNT_PER_HOUR=3
RESEND_LIMIT_PER_IP_PER_HOUR=10
# "Someone tried to register with your address" mails, per address per day.
REGISTER_NOTICE_LIMIT_PER_DAY=3

# ── Mail ─────────────────────────────────────────────────────────
# Development: Mailpit catches every message (web inbox http://127.0.0.1:8025).
#   docker run -d --name voluntag-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit
# Hosting: a real provider, e.g. SMTP_HOST=smtp.example.com SMTP_PORT=587
#   SMTP_STARTTLS=true plus SMTP_USERNAME / SMTP_PASSWORD (keep those secret).
# false = log "not sent" instead of sending
MAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=VolunTag <no-reply@voluntag.local>
# Public address of the frontend; used in password reset and email
# confirmation links.
FRONTEND_BASE_URL=http://localhost:3000
# How long a reset link works.
PASSWORD_RESET_MINUTES=30
# Contact-form messages are always stored and shown in the admin console
# (/admin -> "Contact messages"). true = ALSO mail each one to CONTACT_INBOX.
CONTACT_SEND_EMAIL=false
# Where contact-form messages are mailed when CONTACT_SEND_EMAIL=true.
# Placeholder until a real inbox exists.
CONTACT_INBOX=contact@voluntag.example
# Secret mixed into the stored hash of contact-form IP addresses. Blank = a
# random value per start. Set a long random string in production.
IP_HASH_SALT=

# ── Report a problem: photo / description check ──────────────────
# enforce = reject a report whose photos do not match its description (422)
# log     = accept it, write the score to the log (DEFAULT)
# off     = do not compute the check
# Calibration on the existing reports could not separate matching from
# mismatching photos (see DEPLOY.md), so keep "log" until it is re-calibrated.
REPORT_MISMATCH_MODE=log
# CLIP cosine similarity; a report is a mismatch when EVERY photo is below it.
REPORT_MISMATCH_CLIP_MIN=0.14

# ── Matching ─────────────────────────────────────────────────────
# Small bonus (at most 5 % of the score) for volunteers with at least
# MATCH_RATING_MIN_COUNT rated, attended events.
MATCH_USE_RATINGS=true
MATCH_RATING_MIN_COUNT=3
MATCH_RATING_MAX_BONUS=0.05
# Hybrid scoring (word forms + skill overlap, no keyword-required rule).
# Off: it lowered the self-made evaluation (tools/match_eval). Default false.
MATCH_V2=false
# Rows returned by the public, anonymised GET /match demo (max 50).
MATCH_PUBLIC_ROW_LIMIT=24

# create_admin_password.py reads DATA_DIR too: run it with the same value as
# the server so admin_secret.json lands where the server looks for it.

# Already supported, unchanged (read by the Hugging Face libraries):
# HF_HUB_OFFLINE  main.py sets 1 unless you set it yourself. 1 = use only models
#                 already downloaded; set 0 on a new server to download them once.
# HF_HOME         where the model cache lives (default ~/.cache/huggingface).
#                 On a host, point it at a persistent disk.
