# Backend settings. The backend reads plain environment variables only: it does
# NOT load this file. Export them in your shell, for example
#     export ALLOWED_ORIGINS=https://voluntag.example
# or set them in your hosting provider's settings. Every variable is optional;
# when unset, the backend behaves exactly as it does locally today.

# Folder for everything the app writes and must keep between restarts:
# voluntag.db, uploads/ (with messages/ and resolutions/) and admin_secret.json.
# Created if missing. On a host, point it at a persistent disk.
# Keep it outside the git repository: only the default locations are git-ignored.
# Default (blank or unset): the backend folder itself.
DATA_DIR=

# Frontend addresses allowed to call the API (CORS), comma-separated.
# Scheme + host + port only, e.g. https://voluntag.example
# Spaces, empty items and a trailing slash are ignored.
# Default: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Insert the demo .test volunteers and NGOs when those tables are empty.
# false creates the tables only. Accepts true/false, 1/0, yes/no, on/off.
# Default: true
SEED_DEMO_DATA=true

# create_admin_password.py reads DATA_DIR too: run it with the same value as
# the server so admin_secret.json lands where the server looks for it.

# Already supported, unchanged (read by the Hugging Face libraries):
# HF_HUB_OFFLINE  main.py sets 1 unless you set it yourself. 1 = use only models
#                 already downloaded; set 0 on a new server to download them once.
# HF_HOME         where the model cache lives (default ~/.cache/huggingface).
#                 On a host, point it at a persistent disk.
