# Frontend settings. Copy this file to .env (git-ignored) and change the values,
# or set the same variables in your hosting provider's build settings.
#
# Create React App reads these when the app is BUILT or the dev server STARTS,
# so restart `npm start` or rebuild after changing them.

# Backend (FastAPI) address, with no trailing slash.
# Default when unset: http://127.0.0.1:8000
# Deployed example:   https://api.your-domain.example
REACT_APP_API_BASE=http://127.0.0.1:8000
